// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Waitlist {
  id               String   @id @default(cuid())
  patientName      String
  email            String
  phone            String
  serviceId        String
  service          Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  notes            String?  @db.Text
  hasAcceptedTerms Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@index([serviceId])
}

model Service {
  id           String        @id @default(cuid())
  name         String
  duration     Int
  price        Float
  isActive     Boolean       @default(true)
  reservations Reservation[]
  waitlist     Waitlist[]
}

model Admin {
  id               String   @id @default(cuid())
  email            String   @unique
  password         String
  twoFactorEnabled Boolean  @default(false)
  twoFactorSecret  String?  @db.Text
  recoveryCodes    String   @default("[]") @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SystemLog {
  id        String   @id @default(cuid())
  action    String
  details   String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([action, createdAt])
}

model Reservation {
  id                  String            @id @default(cuid())
  patientName         String
  email               String
  phone               String
  date                DateTime
  status              ReservationStatus @default(PENDING)
  serviceId           String
  service             Service           @relation(fields: [serviceId], references: [id])
  magicToken          String            @unique @default(uuid())
  privateNotes        String?           @db.Text
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  hasAcceptedTerms    Boolean           @default(false)
  rescheduleRequested Boolean           @default(false)
  isManual            Boolean           @default(false)

  amountPaid    Float?
  currency      String  @default("PLN")
  paymentLink   String? @db.Text
  paymentMethod String?

  stripePaymentIntentId String?

  @@index([date, status])
  @@index([email])
}

enum ReservationStatus {
  PENDING
  PAID
  CANCELLED
  COMPLETED
}

model WeeklySchedule {
  id        String  @id @default(cuid())
  dayOfWeek Int     @unique
  startTime String
  endTime   String
  isActive  Boolean @default(true)
}

model BlockedTime {
  id        String   @id @default(cuid())
  startDate DateTime
  endDate   DateTime
  reason    String?
  isFullDay Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([startDate, endDate])
}

model Post {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  content     Json
  isPublished Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, order])
}

model HeroTemplate {
  id                String     @id @default(cuid())
  title             String
  subtitle          String     @db.Text
  imageUrl          String?
  layout            HeroLayout @default(TEXT_LEFT)
  imageStyle        ImageStyle @default(HORIZONTAL)
  showPrimaryButton Boolean    @default(true)
  primaryButtonText String     @default("Poznaj moje podejście")
  primaryButtonLink String     @default("/#o-mnie")
  showZnanyLekarz   Boolean    @default(true)
  isActive          Boolean    @default(false)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model DeviceSession {
  id         String   @id @default(cuid())
  adminEmail String
  ipAddress  String
  userAgent  String
  deviceInfo String
  createdAt  DateTime @default(now())
  isValid    Boolean  @default(true)

  @@index([adminEmail, isValid])
}

model ClinicSettings {
  id             String   @id @default("global")
  clinicName     String   @default("Gabinet Psychoterapii")
  email          String   @default("")
  phone          String   @default("")
  address        String   @default("")
  bankAccount    String?
  nipNumber      String?
  instagramUrl   String?
  facebookUrl    String?
  znanyLekarzUrl String?
  linkedinUrl    String?
  updatedAt      DateTime @updatedAt
}

enum HeroLayout {
  TEXT_LEFT
  TEXT_RIGHT
}

enum ImageStyle {
  HORIZONTAL
  VERTICAL
  SQUARE
}
