DATABASE_URL="postgresql://user:password@localhost:5432/db_name"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_secret_here"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

RESEND_API_KEY="resend_api_key"

CRON_SECRET="your_cron_secret_here"

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="TestPassword123!"
# Optional: bcrypt hash used for timing-safe logins to non-existent accounts (a built-in default is used otherwise)
DUMMY_HASH=""

# Key used to encrypt TOTP secrets and hash recovery codes at rest (falls back to NEXTAUTH_SECRET).
# Changing it invalidates existing 2FA enrolment — the admin will have to set 2FA up again.
TWO_FACTOR_ENCRYPTION_KEY="generate_with_openssl_rand_base64_32"

# Cloudflare Turnstile (anti-bot on reservation & waitlist forms). Leave empty to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Optional override for admin notification e-mails
ADMIN_NOTIFICATION_EMAIL=""
